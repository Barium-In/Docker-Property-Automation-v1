# Copy to qubo.env (gitignored) and fill in. qubo.env holds your Qubo login,
# so it stays out of git and off the shared root .env.

# --- Auth (pick ONE) ---------------------------------------------------------
# A) Easiest: the bridge logs in and saves a session to ./data (reused after).
QUBO_EMAIL=
QUBO_PASSWORD=
# B) Or seed ./data/qubopy_session.json yourself and leave the two above blank
#    (see README "Seeding a session instead of storing the password").

# --- Which camera / identity (optional; sensible defaults) -------------------
# QUBO_DEVICE=            # camera UUID or a substring of its name; default: 1st camera
# QUBO_MOBILE_UUID=       # a registered phone's UUID; default: 1st mobile on the account

# --- Stream ------------------------------------------------------------------
QUBO_QUALITY=high         # high = 1920x1080, low = 640x480
QUBO_AUDIO=0              # 1 = include mic audio (AAC); start with 0, enable once video is solid
# QUBO_LOCAL_IP=          # default: auto-detected VM LAN IP (the camera streams here)
QUBO_LOCAL_PORT=49700

# --- Output / misc -----------------------------------------------------------
RTSP_PUBLISH_URL=rtsp://127.0.0.1:8554/qubo
TZ=Asia/Kolkata
LOG_LEVEL=INFO

# NOTE: the password that protects *reading* the stream is set LITERALLY in
# mediamtx.yml (mediamtx can't read it from here). Use the same user/pass in
# Home Assistant. The bridge publishes from localhost and needs no password.
